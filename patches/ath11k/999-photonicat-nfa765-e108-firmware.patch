+		snprintf(buf, buf_len, "%s/%s/nfa765-e108/%s", ATH11K_FW_DIR,
+			 ab->hw_params.fw.dir, filename);
+		return;
+	}
+
 	if (!fw_name)
 		fw_name = ath11k_core_get_usecase_firmware(ab);
 
