config autorate 'main'
	option enabled '0'
	# auto 跟随 mwan3 中实际的 QModem 接口，不固定 6_1/6_2。
	option interface 'auto'
	# 单位 Kbit/s；填入实测值后才允许启动：最低 <= 基准 <= 最高。
	option min_download '0'
	option base_download '0'
	option max_download '0'
	option min_upload '0'
	option base_upload '0'
	option max_upload '0'
	list reflector '223.5.5.5'
	list reflector '119.29.29.29'
	list reflector '1.1.1.1'
