#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
START=97
STOP=4
USE_PROCD=1

start_service() {
	[ "$(uci -q get cake-autorate.main.enabled)" = 1 ] || return 0
	local config
	config="$(/usr/libexec/cake-autorate-prepare config)" || return 1
	procd_open_instance primary
	procd_set_param command /usr/lib/cake-autorate/cake-autorate.sh "$config"
	procd_set_param env CAKE_AUTORATE_SCRIPT_PREFIX=/usr/lib/cake-autorate CAKE_AUTORATE_CONFIG_PREFIX=/var/run/photonicat-cake-autorate
	procd_set_param file /etc/config/cake-autorate /etc/config/sqm
	procd_set_param respawn 3600 5 3
	procd_set_param term_timeout 10
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger cake-autorate sqm qmodem
}
