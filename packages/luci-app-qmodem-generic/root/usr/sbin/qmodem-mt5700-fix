#!/bin/sh
# MT5700 可选拨号前 SIM 槽切换，仅在用户明确指定配置节和目标槽时修改 UCI。
set -eu

usage() {
	echo '用法: qmodem-mt5700-fix --slot 0|1 <qmodem 配置节>' >&2
	exit 2
}

[ "$#" -eq 3 ] && [ "$1" = --slot ] || usage
slot="$2"
section="$3"
case "$slot" in 0|1) ;; *) usage ;; esac
case "$section" in ''|*[!A-Za-z0-9_-]*) usage ;; esac

kind=$(uci -q get "qmodem.$section" 2>/dev/null || true)
[ "$kind" = modem-device ] || { echo "qmodem.$section 不是 modem-device 配置节" >&2; exit 1; }
model=$(uci -q get "qmodem.$section.model" 2>/dev/null || true)
name=$(uci -q get "qmodem.$section.name" 2>/dev/null || true)
case "$model $name" in
	*[Mm][Tt]5700*) ;;
	*) echo "qmodem.$section 不是 MT5700 系列模组" >&2; exit 1 ;;
esac

case "$slot" in
	0) command='AT^SCICHG=0,1'; other='AT^SCICHG=1,0' ;;
	1) command='AT^SCICHG=1,0'; other='AT^SCICHG=0,1' ;;
esac
existing=$(uci -q show "qmodem.$section.pre_dial_at_cmds" 2>/dev/null || true)
case "$existing" in
	*"'$other'"*) echo "已配置另一个 SIM 槽命令，请先手动检查 qmodem.$section.pre_dial_at_cmds" >&2; exit 1 ;;
	*"'$command'"*) echo "qmodem.$section 已包含 $command"; exit 0 ;;
esac

uci add_list "qmodem.$section.pre_dial_at_cmds=$command"
uci commit qmodem
logger -t qmodem-mt5700-fix "已为 qmodem.$section 添加拨号前命令 $command"
echo "已为 qmodem.$section 添加 $command"
