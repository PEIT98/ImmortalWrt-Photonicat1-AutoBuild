#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Manage package repository origins independently of the MCU and firmware updater.
set -eu
umask 077
ROOT="${PHOTONICAT_PACKAGE_ROOT:-}"
CONFIG="$ROOT/etc/config"
LIBRARY="$ROOT/usr/share/photonicat/package-sources.awk"
ACTION="${1:-status}"
OFFICIAL='https://downloads.immortalwrt.org'
NJU='https://mirror.nju.edu.cn/immortalwrt'
work=
committed=0
created_config=0

error() { jq -nc --arg error "$1" '{ok:false,error:$error}'; exit 1; }
read_source() {
    source="$(uci -c "$CONFIG" -q get photonicat_packages.main.source 2>/dev/null || true)"
    case "$source" in nju|official) ;; *) source=nju ;; esac
}
files() {
    for file in "$ROOT/etc/apk/repositories" "$ROOT/etc/apk/repositories.d/"*.list \
        "$ROOT/etc/apk/repositories.d/"*.repositories \
        "$ROOT/etc/opkg/distfeeds.conf" "$ROOT/etc/opkg/customfeeds.conf"; do
        [ -f "$file" ] && [ ! -L "$file" ] || continue
        case "${file##*/}" in ''|*[!A-Za-z0-9_.-]*) continue ;; esac
        printf '%s\n' "$file"
    done
}
statistics() {
    files | while IFS= read -r file; do
        awk -v destination="$destination" -v mode=scan -f "$LIBRARY" "$file"
    done | awk '{official+=$1; nju+=$2; other+=$3; changed+=$4}
        END {print official+0, nju+0, other+0, changed+0}'
}
status() {
    read_source
    destination="$NJU"
    [ "$source" != official ] || destination="$OFFICIAL"
    stats="$(statistics)"
    # Statistics contain only the four numeric counters generated by our awk helper.
    set -- $stats
    known=$(($1 + $2))
    actual=custom
    if [ "$known" -gt 0 ]; then
        if [ "$1" -gt 0 ] && [ "$2" -gt 0 ]; then actual=mixed
        elif [ "$1" -gt 0 ]; then actual=official
        else actual=nju; fi
    fi
    jq -nc --arg source "$source" --arg actual "$actual" --arg mirror "$destination" \
        --argjson repositories "$known" --argjson custom "$3" --argjson pending "$4" \
        --argjson changed "${changed:-0}" \
        '{ok:true,source:$source,actual:$actual,mirror:$mirror,repositories:$repositories,
          custom_repositories:$custom,pending:($pending>0),changed:$changed,supported:($repositories>0)}'
}
cleanup() {
    code=$?
    trap - EXIT HUP INT TERM
    if [ -n "$work" ] && [ "$committed" != 1 ]; then
        # Roll back every changed list if a later rename or UCI commit failed.
        if [ -f "$work/files" ]; then
            n=0
            while IFS= read -r file; do
                n=$((n + 1))
                [ -f "$work/original.$n" ] || continue
                rollback="$(mktemp "${file%/*}/.photonicat-source.XXXXXX")" || continue
                if cp -p "$work/original.$n" "$rollback"; then mv -f "$rollback" "$file" || :
                else rm -f "$rollback"; fi
            done < "$work/files"
        fi
        if [ -f "$work/config.original" ]; then
            cp -p "$work/config.original" "$CONFIG/photonicat_packages" || :
        elif [ "$created_config" = 1 ]; then
            rm -f "$CONFIG/photonicat_packages"
        fi
    fi
    [ -z "$work" ] || rm -rf "$work"
    exit "$code"
}
apply() {
    [ "$(cat "$ROOT/tmp/sysinfo/board_name" 2>/dev/null || true)" = 'ariaboard,photonicat' ] ||
        error '此设置仅适用于光影猫一代'
    destination="$NJU"
    [ "$source" != official ] || destination="$OFFICIAL"
    mkdir -p "$ROOT/var/lock" "$ROOT/tmp"
    exec 9>"$ROOT/var/lock/photonicat-package-source.lock"
    flock -n 9 || error '软件源正在保存，请稍后重试'
    work="$(mktemp -d "$ROOT/tmp/photonicat-package-source.XXXXXX")" || error '无法创建临时目录'
    trap cleanup EXIT
    trap 'exit 1' HUP INT TERM
    files > "$work/files"
    stats="$(statistics)"
    set -- $stats
    [ "$(($1 + $2))" -gt 0 ] || error '未找到可切换的 ImmortalWrt 软件源，请到软件包管理检查地址'
    mkdir -p "$CONFIG" "$work/uci"
    [ ! -L "$CONFIG/photonicat_packages" ] || error '软件源设置文件无效'
    if [ -e "$CONFIG/photonicat_packages" ]; then
        cp -p "$CONFIG/photonicat_packages" "$work/config.original" || error '无法备份软件源设置'
    else
        : > "$CONFIG/photonicat_packages"
        created_config=1
    fi
    n=0
    changed=0
    # Prepare all lists before replacing any list. Third-party URLs remain verbatim.
    while IFS= read -r file; do
        n=$((n + 1))
        count="$(awk -v destination="$destination" -v mode=scan -f "$LIBRARY" "$file" | awk '{print $4}')"
        [ "$count" -gt 0 ] || continue
        cp -p "$file" "$work/original.$n" || error '无法备份原软件源'
        cp -p "$file" "$work/updated.$n" || error '无法准备软件源'
        awk -v destination="$destination" -v mode=rewrite -f "$LIBRARY" "$file" > "$work/updated.$n" ||
            error '软件源转换失败'
        changed=$((changed + count))
    done < "$work/files"
    n=0
    while IFS= read -r file; do
        n=$((n + 1))
        [ -f "$work/updated.$n" ] || continue
        temporary="$(mktemp "${file%/*}/.photonicat-source.XXXXXX")" || error '软件源目录不可写'
        if ! cp -p "$work/updated.$n" "$temporary" || ! mv -f "$temporary" "$file"; then
            rm -f "$temporary"
            error '软件源保存失败，已尝试恢复原设置'
        fi
    done < "$work/files"
    if ! uci -c "$CONFIG" -t "$work/uci" set photonicat_packages.main=settings ||
       ! uci -c "$CONFIG" -t "$work/uci" set "photonicat_packages.main.source=$source" ||
       ! uci -c "$CONFIG" -t "$work/uci" commit photonicat_packages; then
        error '软件源设置保存失败，已尝试恢复原设置'
    fi
    committed=1
    status
}
[ -f "$LIBRARY" ] || error '缺少软件源管理组件'
case "$ACTION" in
    status) status ;;
    apply) read_source; apply ;;
    set)
        request="$(head -c 4097)"
        [ "${#request}" -le 4096 ] || error '请求内容过长'
        source="$(printf '%s' "$request" | jq -ser '
            select(length==1) | .[0] | select(type=="object") |
            .source | select(.=="nju" or .=="official")')" || error '请选择加速镜像或官方源'
        apply
        ;;
    *) error '不支持的操作' ;;
esac
