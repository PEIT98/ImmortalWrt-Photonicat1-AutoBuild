#!/bin/sh
# Read-only status for the Aurora header. The two Ethernet ports belong to
# Photonicat v1; radios are discovered from the kernel, never assumed to be two.
. /usr/share/libubox/jshn.sh
. /lib/functions.sh

case "$1:$2" in
    list:*) printf '%s\n' '{"status":{}}'; exit 0 ;;
    call:status) ;;
    *) exit 1 ;;
esac

modem_sections=
collect_modem() {
    config_get enabled "$1" enabled 1
    [ "$enabled" = 0 ] || modem_sections="$modem_sections $1"
}

connection=no
generation=''
rsrp=''
bars=0
if [ -f /etc/config/qmodem ] && ubus -S list qmodem >/dev/null 2>&1; then
    config_load qmodem
    config_foreach collect_modem modem-device
    [ -z "$modem_sections" ] || connection=unknown
    all_disconnected=1
    for section in $modem_sections; do
        # This is the same connected state shown by QModem, not its dialer process state.
        connect="$(timeout 6 ubus -S call qmodem get_connect_status "{\"config_section\":\"$section\"}" 2>/dev/null)" || connect=''
        if [ -z "$connect" ] || ! json_load "$connect" 2>/dev/null; then
            all_disconnected=0
            continue
        fi
        json_get_var reported connection_status
        case "$reported" in
            Yes|yes|connected|Connected|1|true)
                connection=yes
                break
                ;;
            No|no|disconnected|Disconnected|0|false) ;;
            *) all_disconnected=0 ;;
        esac
    done
    if [ "$connection" != yes ] && [ "$all_disconnected" = 1 ]; then
        connection=no
    fi
fi

if [ "$connection" = yes ]; then
    # The current RAT and RSRP come from QModem's serving-cell readings.
    # A slow AT reply must not turn a connected modem into "no service".
    cell="$(timeout 10 ubus -S call qmodem cell_info "{\"config_section\":\"$section\"}" 2>/dev/null)" || cell=''
    network_mode=''
    lte_rsrp='' nr_rsrp='' other_rsrp=''
    if [ -n "$cell" ] && json_load "$cell" 2>/dev/null && json_select modem_info 2>/dev/null; then
        json_get_keys entries
        for entry in $entries; do
            json_select "$entry" 2>/dev/null || continue
            json_get_var key key
            json_get_var value value
            json_get_var extra extra_info
            case "$key" in
                network_mode|'Network Mode') network_mode="$value" ;;
                RSRP)
                    case "$extra" in
                        *NR*|*5G*) nr_rsrp="$value" ;;
                        *LTE*|*4G*) lte_rsrp="$value" ;;
                        *) other_rsrp="$value" ;;
                    esac
                    ;;
            esac
            json_select ..
        done
        json_select ..
    fi
    # Some modem implementations report the current RAT only in network_info.
    if [ -z "$network_mode" ]; then
        network="$(timeout 5 ubus -S call qmodem network_info "{\"config_section\":\"$section\"}" 2>/dev/null)" || network=''
        if [ -n "$network" ] && json_load "$network" 2>/dev/null && json_select modem_info 2>/dev/null; then
            json_get_keys entries
            for entry in $entries; do
                json_select "$entry" 2>/dev/null || continue
                json_get_var key key
                json_get_var value value
                [ "$key" != 'Network Type' ] || network_mode="$value"
                json_select ..
            done
            json_select ..
        fi
    fi
    case "$network_mode" in
        *EN-DC*|*NR*|*5G*) generation=5G; rsrp="${nr_rsrp:-${lte_rsrp:-$other_rsrp}}" ;;
        *LTE*|*4G*) generation=4G; rsrp="${lte_rsrp:-$other_rsrp}" ;;
    esac
fi

# QModem uses -80/-90/-100 dBm as RSRP quality boundaries.
rsrp_int="${rsrp%%.*}"
case "$rsrp_int" in
    -[0-9]*)
        case "${rsrp_int#-}" in *[!0-9]*|'') rsrp_int='' ;; esac
        if [ -n "$rsrp_int" ] && [ "$rsrp_int" -ge -140 ] && [ "$rsrp_int" -le -44 ]; then
            if [ "$rsrp_int" -ge -80 ]; then bars=4
            elif [ "$rsrp_int" -ge -90 ]; then bars=3
            elif [ "$rsrp_int" -ge -100 ]; then bars=2
            else bars=1; fi
        else rsrp=''; fi
        ;;
    *) rsrp='' ;;
esac

# The PMU status method already contains both auto-start and schedule state.
mode=''
power="$(ubus -S call luci.photonicat_power status 2>/dev/null)" || power=''
if [ -n "$power" ] && json_load "$power" 2>/dev/null; then
    json_get_var ok ok
    json_get_var car_state car_state
    json_get_var schedule schedule
    if [ "$ok" = 1 ] || [ "$ok" = true ]; then
        mode=manual
        if [ "$car_state" = 1 ]; then
            mode=car
        elif [ -n "$schedule" ] && json_load "$schedule" 2>/dev/null && json_select event-list 2>/dev/null; then
            json_get_keys events
            for event in $events; do
                json_select "$event" 2>/dev/null || continue
                json_get_var enabled enabled
                json_get_var action action
                json_select ..
                if [ "$enabled" != 0 ] && { [ "$action" = 0 ] || [ "$action" = 1 ]; }; then
                    mode=timer
                    break
                fi
            done
        fi
    fi
fi

json_init
json_add_object cellular
json_add_string connection "$connection"
json_add_string generation "$generation"
json_add_int bars "$bars"
json_add_string rsrp "$rsrp"
json_close_object

json_add_array ethernet
for port in eth0 eth1; do
    json_add_object
    json_add_string name "$port"
    case "$port" in eth0) json_add_string label WAN ;; eth1) json_add_string label LAN ;; esac
    carrier="$(cat "/sys/class/net/$port/carrier" 2>/dev/null)"
    [ "$carrier" = 1 ] || carrier=0
    json_add_boolean linked "$carrier"
    json_close_object
done
json_close_array

# A PHY is proof the kernel registered the radio. An instantiated interface
# must also be administratively up before its icon appears enabled.
interfaces="$(iw dev 2>/dev/null | awk '/^phy#[0-9]+/ { phy=substr($1,5) } /^[[:space:]]*Interface / { print "phy" phy, $2 }')"
json_add_array wifi
for device in /sys/class/ieee80211/phy*; do
    [ -d "$device" ] || continue
    phy="${device##*/}"
    driver=''
    driver_path="$(readlink -f "$device/device/driver" 2>/dev/null)"
    [ -z "$driver_path" ] || driver="${driver_path##*/}"
    active=0
    for netdev in $(printf '%s\n' "$interfaces" | awk -v target="$phy" '$1 == target { print $2 }'); do
        flags="$(cat "/sys/class/net/$netdev/flags" 2>/dev/null)"
        case "$flags" in 0x*) [ $((flags & 1)) -eq 1 ] && active=1 ;; esac
    done
    json_add_object
    json_add_string phy "$phy"
    json_add_string driver "$driver"
    json_add_boolean enabled "$active"
    json_close_object
done
json_close_array
json_add_string mode "$mode"
json_dump
