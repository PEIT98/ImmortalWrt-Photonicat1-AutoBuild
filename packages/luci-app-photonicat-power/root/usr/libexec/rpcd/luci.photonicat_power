#!/bin/sh
# Photonicat v1: only use the official Unix control socket.
# Never open /dev/ttyS4; only the bundled pcat-manager holds the MCU serial port.
. /usr/share/libubox/jshn.sh

SOCK=/tmp/pcat-manager.sock
BOARD="$(cat /tmp/sysinfo/board_name 2>/dev/null)"

fail() {
    json_init
    json_add_boolean ok 0
    json_add_string error "$1"
    json_dump
    exit 0
}

require_controller() {
    [ "$BOARD" = "ariaboard,photonicat" ] || fail "仅支持光影猫一代（ariaboard,photonicat）"
    command -v socat >/dev/null 2>&1 || fail "缺少 socat 通信程序"
    [ -S "$SOCK" ] || fail "未检测到 PMU 管理器 Socket；请检查 pcat-manager 服务和 /dev/ttyS4。"
}

query() {
    # Official C daemon sends replies asynchronously. Plain socat '-' sends socket EOF
    # immediately after printf, causing the daemon to close before flushing the reply.
    # STDIO,ignoreeof keeps the write half open until the response arrives.
    # -T bounds idle time because the daemon intentionally keeps clients connected.
    MCU_REPLY="$(printf '%s\000' "$1" | socat -T "${3:-1}" STDIO,ignoreeof "UNIX-CONNECT:$SOCK" 2>/dev/null | tr -d '\000')"
    [ -n "$MCU_REPLY" ] || return 1
    validate_reply "$MCU_REPLY" "$2"
}

validate_reply() {
    json_load "$1" 2>/dev/null || return 1
    json_get_var _code code
    json_get_var _command command
    [ "$_code" = "0" ] && [ "$_command" = "$2" ]
}

# socat's -T 1 adds a noticeable post-response wait because the daemon
# keeps the control connection open. On a local Unix socket, use a short
# read-only grace period and retry with the original timeout if necessary.
# Never change the timeout/validation used for MCU write commands.
decode_status_batch() {
    _pmu_reply="$(printf '%s\n' "$_status_replies" | sed -n '1p')"
    _car_reply="$(printf '%s\n' "$_status_replies" | sed -n '2p')"
    _schedule_reply="$(printf '%s\n' "$_status_replies" | sed -n '3p')"
    [ -n "$_pmu_reply" ] && [ -n "$_car_reply" ] || return 1
    validate_reply "$_pmu_reply" "pmu-status" &&
        validate_reply "$_car_reply" "charger-on-auto-start-get" || return 1
    [ "$1" = runtime ] || validate_reply "$_schedule_reply" "schedule-power-event-get"
}

query_status_batch() {
    _status_commands='{"command":"pmu-status"}
{"command":"charger-on-auto-start-get"}'
    if [ "$1" != runtime ]; then
        _status_commands="$_status_commands
{\"command\":\"schedule-power-event-get\"}"
    fi
    _status_replies="$(printf '%s\n' "$_status_commands" | tr '\n' '\000' |
        socat -T 0.25 STDIO,ignoreeof "UNIX-CONNECT:$SOCK" 2>/dev/null | tr '\000' '\n')"
    if decode_status_batch "$1"; then
        return 0
    fi
    # Retry the whole read-only request; never apply this to mode changes.
    _status_replies="$(printf '%s\n' "$_status_commands" | tr '\n' '\000' |
        socat -T 1 STDIO,ignoreeof "UNIX-CONNECT:$SOCK" 2>/dev/null | tr '\000' '\n')"
    decode_status_batch "$1"
}

parse_battery() {
    json_get_var battery_mv battery-voltage
    json_get_var charger_mv charger-voltage
    json_get_var battery_percentage charge-percentage
    json_get_var on_battery on-battery
    json_get_var board_temp board-temperature
    for _n in "$battery_mv" "$charger_mv" "$battery_percentage" "$on_battery"; do
        case "$_n" in ''|*[!0-9]*) fail "电池状态数据格式错误" ;; esac
    done
    case "${board_temp#-}" in ''|*[!0-9]*) board_temp=0 ;; esac
    [ "$battery_mv" -gt 0 ] || fail "MCU 尚未上报有效电压，暂时禁止修改电源模式"
    [ "$battery_percentage" -le 10000 ] || battery_percentage=10000
    battery_percentage=$(( (battery_percentage + 50) / 100 ))
}

add_battery_json() {
    json_add_int battery_percentage "$battery_percentage"
    json_add_int battery_mv "$battery_mv"
    json_add_int charger_mv "$charger_mv"
    json_add_int on_battery "$on_battery"
    json_add_int board_temp "$board_temp"
}

send_checked() {
    query "$1" "$2" || fail "MCU 命令 $2 执行失败；请检查后台服务，部分设置可能已生效"
}

load_request() {
    # rpcd exec plugins pass ubus call parameters through stdin, NOT argv[3].
    # Read the full payload before json_load; empty/invalid data must never change MCU settings.
    request="$(cat)"
    [ -n "$request" ] || fail "缺少请求参数"
    json_load "$request" 2>/dev/null || fail "参数 JSON 错误"
}

valid_time() {
    case "$1" in
        0[0-9]:[0-5][0-9]|1[0-9]:[0-5][0-9]|2[0-3]:[0-5][0-9]) return 0 ;;
        *) return 1 ;;
    esac
}

event_for() {
    _time="$1"
    _action="$2"
    _hour="${_time%:*}"
    _minute="${_time#*:}"
    _hour="${_hour#0}"
    _minute="${_minute#0}"
    [ -n "$_hour" ] || _hour=0
    [ -n "$_minute" ] || _minute=0
    printf '{"action":%s,"enabled":1,"enable-bits":56,"hour":%s,"minute":%s,"dow-bits":127}' "$_action" "$_hour" "$_minute"
}

case "$1" in
    list)
        printf '%s\n' '{"status":{},"runtime":{},"battery":{},"set_mode":{"mode":"str","minutes":"int"},"set_daily":{"start":"str","stop":"str"}}'
        ;;
    call)
        require_controller
        case "$2" in
            battery)
                query '{"command":"pmu-status"}' "pmu-status" 0.25 ||
                    query '{"command":"pmu-status"}' "pmu-status" 1 ||
                    fail "MCU 电池状态读取失败"
                parse_battery
                json_init
                json_add_boolean ok 1
                add_battery_json
                json_dump
                ;;
            status|runtime)
                query_status_batch "$2" || fail "MCU 状态响应不完整"
                validate_reply "$_pmu_reply" "pmu-status" || fail "MCU 电池状态读取失败"
                parse_battery
                validate_reply "$_car_reply" "charger-on-auto-start-get" || fail "读取车载模式失败"
                json_get_var car_state state
                json_get_var car_seconds timeout
                json_get_var car_countdown countdown
                case "$car_countdown" in ""|*[!0-9-]*) car_countdown=-1 ;; esac
                case "$car_state:$car_seconds" in *[!0-9:]*|'') fail "车载模式返回无效数据" ;; esac
                if [ "$2" = status ]; then
                    validate_reply "$_schedule_reply" "schedule-power-event-get" || fail "读取定时计划失败"
                    schedule="$_schedule_reply"
                fi
                json_init
                json_add_boolean ok 1
                add_battery_json
                json_add_int car_state "${car_state:-0}"
                json_add_int car_seconds "${car_seconds:-0}"
                json_add_int car_countdown "$car_countdown"
                [ "$2" != status ] || json_add_string schedule "$schedule"
                json_add_string backend "Photonicat PMU Socket"
                json_dump
                ;;
            set_mode)
                load_request
                json_get_var mode mode
                json_get_var minutes minutes
                case "$mode" in
                    manual)
                        send_checked '{"command":"charger-on-auto-start-set","state":0,"timeout":0}' "charger-on-auto-start-set"
                        send_checked '{"command":"schedule-power-event-set","event-list":[]}' "schedule-power-event-set"
                        ;;
                    car)
                        case "$minutes" in ''|*[!0-9]*) fail "延时必须为 0～600 分钟的整数" ;; esac
                        [ "$minutes" -le 600 ] || fail "延时不能超过 600 分钟"
                        seconds=$((minutes * 60))
                        send_checked '{"command":"schedule-power-event-set","event-list":[]}' "schedule-power-event-set"
                        send_checked "{\"command\":\"charger-on-auto-start-set\",\"state\":1,\"timeout\":$seconds}" "charger-on-auto-start-set"
                        ;;
                    *) fail "未知模式（应为 manual 或 car）" ;;
                esac
                json_init
                json_add_boolean ok 1
                json_dump
                ;;
            set_daily)
                load_request
                json_get_var start start
                json_get_var stop stop
                valid_time "$start" && valid_time "$stop" || fail "时间格式必须为 HH:MM"
                [ "$start" != "$stop" ] || fail "开机和关机时间不能相同"
                start_ev="$(event_for "$start" 1)"
                stop_ev="$(event_for "$stop" 0)"
                send_checked '{"command":"charger-on-auto-start-set","state":0,"timeout":0}' "charger-on-auto-start-set"
                send_checked "{\"command\":\"schedule-power-event-set\",\"event-list\":[$start_ev,$stop_ev]}" "schedule-power-event-set"
                json_init
                json_add_boolean ok 1
                json_dump
                ;;
            *) fail "不支持的方法" ;;
        esac
        ;;
    *) exit 1 ;;
esac
