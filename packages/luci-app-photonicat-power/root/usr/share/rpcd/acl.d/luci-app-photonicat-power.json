{
  "luci-app-photonicat-power": {
    "description": "Photonicat v1 MCU power policy",
    "read": {
      "ubus": {
        "luci.photonicat_power": [
          "status",
          "runtime",
          "battery"
        ],
        "luci.battstatus": ["getBatteryStatus", "getSettings"],
        "luci.photonicat_header": ["status"],
        "luci.photonicat_packages": ["getSettings"]
      }
    },
    "write": {
      "ubus": {
        "luci.photonicat_power": [
          "set_mode",
          "set_daily"
        ],
        "luci.battstatus": ["setSettings"],
        "luci.photonicat_packages": ["setSettings"]
      }
    }
  }
}
