#!/bin/sh

. /usr/share/libubox/jshn.sh

board=$(cat /tmp/sysinfo/board_name)
model=$(cat /tmp/sysinfo/model)

read_settings() {
	indicator_enabled="$(uci -q get luci_battstatus.main.enabled)"
	low_alert="$(uci -q get luci_battstatus.main.low_alert)"
	low_threshold="$(uci -q get luci_battstatus.main.low_threshold)"
	case "$indicator_enabled" in 0|1) ;; *) indicator_enabled=1 ;; esac
	case "$low_alert" in 0|1) ;; *) low_alert=1 ;; esac
	case "$low_threshold" in [5-9]|[1-4][0-9]|50) ;; *) low_threshold=20 ;; esac
}

settings_json() {
	json_init
	json_add_boolean ok 1
	json_add_boolean enabled "$indicator_enabled"
	json_add_boolean low_alert "$low_alert"
	json_add_int low_threshold "$low_threshold"
	json_dump
}

settings_error() {
	json_init
	json_add_boolean ok 0
	json_add_string error "$1"
	json_dump
	exit 0
}

case "$1" in
	list)
		printf '%s\n' '{"getBatteryStatus":{},"getSettings":{},"setSettings":{"enabled":"int","low_alert":"int","low_threshold":"int"}}'
	;;
	call)
		case "$2" in
			getSettings)
				read_settings
				settings_json
			;;
			setSettings)
				request="$(cat)"
				json_load "$request" 2>/dev/null || settings_error "设置格式错误"
				json_get_var indicator_enabled enabled
				json_get_var low_alert low_alert
				json_get_var low_threshold low_threshold
				case "$indicator_enabled:$low_alert" in [01]:[01]) ;; *) settings_error "开关值必须为 0 或 1" ;; esac
				case "$low_threshold" in [5-9]|[1-4][0-9]|50) ;; *) settings_error "提醒电量必须为 5～50 的整数" ;; esac
				# Only commit this plugin's own config, without applying other LuCI changes.
				uci -q batch <<EOF || settings_error "显示设置保存失败"
set luci_battstatus.main=settings
set luci_battstatus.main.enabled='$indicator_enabled'
set luci_battstatus.main.low_alert='$low_alert'
set luci_battstatus.main.low_threshold='$low_threshold'
commit luci_battstatus
EOF
				settings_json
			;;
			getBatteryStatus)
				read_settings
				if [ "$indicator_enabled:$low_alert" = "0:0" ]; then
					# Both UI features are off; avoid querying the MCU from the preload.
					printf '{}\n'
					exit 0
				fi
				# On Photonicat v1, reuse the PMU controller's read-only battery RPC.
				# Parse BEFORE json_init, since json_load resets the jshn output state.
				pcat_valid=0
				if [ "$board" = "ariaboard,photonicat" ]; then
					pcat_reply="$(ubus call luci.photonicat_power battery 2>/dev/null)" || pcat_reply=""
					if [ -n "$pcat_reply" ] && json_load "$pcat_reply" 2>/dev/null; then
						json_get_var pcat_ok ok
						json_get_var pcat_pct battery_percentage
						json_get_var pcat_on_battery on_battery
						case "$pcat_ok" in 1|true) pcat_ok=1 ;; *) pcat_ok=0 ;; esac
						case "$pcat_pct" in ''|*[!0-9]*) pcat_pct='' ;; esac
						case "$pcat_on_battery" in 0|1) ;; *) pcat_on_battery='' ;; esac
						if [ "$pcat_ok" = 1 ] && [ -n "$pcat_pct" ] &&
						   [ "$pcat_pct" -le 100 ] && [ -n "$pcat_on_battery" ]; then
							pcat_valid=1
						fi
					fi
				fi
				json_init
				json_add_object "$model"
				json_add_boolean indicator_enabled "$indicator_enabled"
				json_add_boolean low_alert "$low_alert"
				json_add_int low_threshold "$low_threshold"

				case "$board" in
					ariaboard,photonicat)
						json_add_boolean power_page 1
						if [ "$pcat_valid" = 1 ]; then
							json_add_boolean valid 1
							# 0 = external power present; 1 = running from battery.
							json_add_boolean charging "$((1 - pcat_on_battery))"
							json_add_int percentage "$pcat_pct"
						else
							json_add_boolean valid 0
							json_add_string message "PMU battery RPC unavailable"
						fi
					;;
					ariaboard,photonicat2)
						if [ -d /sys/class/power_supply/battery ]; then
							json_add_boolean valid 1
							json_add_boolean charging $(cat /sys/class/power_supply/charger/online)
							json_add_int percentage $(cat /sys/class/power_supply/battery/capacity)
						else
							json_add_boolean valid 0
							json_add_string message "Need kmod-photonicat-pm"
						fi
					;;
					hootoo,ht-tm05|ravpower,rp-wd009)
						if [ -f /usr/sbin/i2cset ] && [ -f /usr/sbin/i2cget ]; then
							json_add_boolean valid 1
							if [ $(i2cset -y 0 0x0a 0x0a 0x01 && i2cget -y 0 0x0a 0x0a) = 0x40 ]; then
								json_add_boolean charging 1
							else
								json_add_boolean charging 0
							fi
							json_add_int percentage $(i2cset -y 0 0x0a 0x0a 0x10 && i2cget -y 0 0x0a 0x0a | xargs printf %d)
						else
							json_add_boolean valid 0
							if [ ! -f /usr/sbin/i2cset ]; then
								json_add_string message "Need i2cset"
							else
								json_add_string message "Need i2cget"
							fi
						fi
					;;
				*)
					json_add_boolean valid 0
					json_add_string message "Unsupported"
					;;
				esac

				json_close_object
				json_dump
			;;
		esac
	;;
esac
