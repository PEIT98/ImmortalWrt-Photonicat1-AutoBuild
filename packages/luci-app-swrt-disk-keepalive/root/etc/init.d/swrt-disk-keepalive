#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034
START=95
USE_PROCD=1

start_service() {
    [ "$(uci -q get swrt_disk_keepalive.main.enabled)" = 1 ] || return 0
    procd_open_instance
    procd_set_param command /usr/libexec/swrt-disk-keepalive daemon
    procd_set_param respawn 3600 5 5
    procd_set_param term_timeout 20
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger swrt_disk_keepalive
}
