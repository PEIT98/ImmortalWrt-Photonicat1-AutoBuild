# 光影猫一代在线升级：只在页面点击后运行。
config online-upgrade 'settings'
    option enabled '0'
    option repo 'PEIT98/ImmortalWrt-Photonicat1-AutoBuild'
    option tag 'auto'
    option proxy 'https://gh.acg2.mom/'
    option firmware_pattern 'ariaboard_photonicat-squashfs-sysupgrade_[0-9]{10}\.img\.gz$'
    option keep_config '1'
