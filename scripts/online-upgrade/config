# Photonicat1 online firmware upgrades from authenticated GitHub Releases.
# Never automatically flash; LuCI must explicitly ask the administrator first.
config online-upgrade 'settings'
	option enabled '1'
	option repo 'PEIT98/ImmortalWrt-Photonicat1-AutoBuild'
	option tag 'latest'
	option proxy ''
	option keep_config '1'
