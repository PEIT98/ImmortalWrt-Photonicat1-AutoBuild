#!/bin/sh
# 首次安装和旧配置迁移；下载代理留空表示直连，已有自定义配置继续保留。
uci -q get online-upgrade.settings >/dev/null || uci -q set online-upgrade.settings=online-upgrade
repo=$(uci -q get online-upgrade.settings.repo)
case "$repo" in
    ''|gooyjq/ImmortalWrt-Builder|LianXia233/H5000M-CI-Qmodem)
        uci -q set online-upgrade.settings.repo='PEIT98/ImmortalWrt-Photonicat1-AutoBuild'
        uci -q set online-upgrade.settings.tag=auto
        ;;
esac
tag=$(uci -q get online-upgrade.settings.tag)
case "$tag" in ''|Autobuild-x86-64) uci -q set online-upgrade.settings.tag=auto ;; esac
uci -q get online-upgrade.settings.proxy >/dev/null || uci -q set online-upgrade.settings.proxy='https://gh.acg2.mom/'
uci -q get online-upgrade.settings.keep_config >/dev/null || uci -q set online-upgrade.settings.keep_config=1
uci -q set online-upgrade.settings.firmware_pattern='ariaboard_photonicat-squashfs-sysupgrade_[0-9]{10}\.img\.gz$'
uci -q set online-upgrade.settings.enabled=0
uci -q commit online-upgrade
# 清理上游旧版的无认证恢复入口；配置恢复由 LuCI 自带页面处理。
rm -f /www/cgi-bin/online-upgrade-restore
exit 0
