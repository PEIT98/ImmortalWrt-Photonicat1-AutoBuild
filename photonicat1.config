# 光影猫一代自定义覆盖配置（非完整 OpenWrt .config）
# 继承光影猫参考配置，并在安装 Feeds 后应用。
# 在这里设置插件和驱动，不动参考配置的其他选项。
# 使用 CONFIG_PACKAGE_名称=y 启用插件；使用 # CONFIG_PACKAGE_名称 is not set 关闭。
# make defconfig 后由 scripts/checks/verify-config.sh 进行依赖核对。
#
# 固件显示品牌；版本号与设备识别沿用上游，软件包源可在光影猫管理中切换。
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="Pwrt"
CONFIG_VERSION_MANUFACTURER="Photonicat"
CONFIG_VERSION_HOME_URL="https://github.com/PEIT98/ImmortalWrt-Photonicat1-AutoBuild"

# ===== 必需插件、工具、模组及 Wi-Fi 驱动 =====
CONFIG_PACKAGE_qmodem=y
CONFIG_PACKAGE_luci-app-qmodem-next=y
CONFIG_PACKAGE_luci-app-qmodem-generic=y
# 官方 stable 的 Next 界面使用 sms-tool_q 读取短信，保留独立转发后台。
CONFIG_PACKAGE_sms-tool_q=y
CONFIG_PACKAGE_sms-forwarder-next=y
# 模组驱动对齐西瓜皮：官方 stable 厂家 QMI 与 Tom 拨号后端。
# stable 的选项仍使用 luci-app-qmodem 前缀，Next 和 Generic 界面共用后台。
CONFIG_PACKAGE_luci-app-qmodem_INCLUDE_vendor-qmi-wwan=y
CONFIG_PACKAGE_kmod-qmi_wwan_q=y
CONFIG_PACKAGE_kmod-qmi_wwan_f=y
CONFIG_PACKAGE_kmod-qmi_wwan_s=y
# CONFIG_PACKAGE_luci-app-qmodem_INCLUDE_generic-qmi-wwan is not set
# CONFIG_PACKAGE_luci-app-qmodem_INCLUDE_nss-qmi-wwan is not set
# PCIe：移远 MHI 与联发科 T7xx；FM350 的 USB RNDIS 模式仍使用下方 rndis 驱动。
CONFIG_PACKAGE_luci-app-qmodem_INCLUDE_ADD_PCI_SUPPORT=y
CONFIG_PACKAGE_luci-app-qmodem_VENDOR_MHI_PCIe_DRIVER=y
# CONFIG_PACKAGE_luci-app-qmodem_GENERIC_MHI_PCIe_DRIVER is not set
# CONFIG_PACKAGE_luci-app-qmodem_NSS_MHI_PCIe_DRIVER is not set
CONFIG_PACKAGE_kmod-pcie_mhi=y
CONFIG_PACKAGE_luci-app-qmodem_INCLUDE_ADD_MTK_T7XX_SUPPORT=y
CONFIG_PACKAGE_kmod-mtk-t7xx=y
CONFIG_PACKAGE_umbim=y
CONFIG_PACKAGE_qmodem_INCLUDE_SEAL=y
CONFIG_PACKAGE_luci-app-qmodem_USE_TOM_CUSTOMIZED_QUECTEL_CM=y
# 在线升级（只在页面点击后执行；构建时适配光影猫发布文件）。
CONFIG_PACKAGE_luci-app-online-upgrade=y
CONFIG_PACKAGE_curl=y
# 更新器和硬盘保活使用 match/test 等正则函数，必须选择 full 变体。
# CONFIG_PACKAGE_jq is not set
CONFIG_PACKAGE_jq-full=y
CONFIG_PACKAGE_oniguruma=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_flock=y
CONFIG_PACKAGE_coreutils-sha256sum=y
CONFIG_PACKAGE_coreutils-stat=y
CONFIG_PACKAGE_coreutils-dd=y
CONFIG_PACKAGE_coreutils-od=y
CONFIG_PACKAGE_coreutils-timeout=y
# USB 硬盘保活首次关闭，仅操作用户明确选中的 USB 存储设备。
CONFIG_PACKAGE_luci-app-swrt-disk-keepalive=y
# eMMC 自动扩容：在 overlay 挂载前扩展，不覆盖额外的数据分区。
CONFIG_PACKAGE_sfdisk=y
CONFIG_PACKAGE_partx-utils=y
CONFIG_PACKAGE_blockdev=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_losetup=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_f2fsck=y
CONFIG_PACKAGE_mkf2fs=y
# Loop/F2FS 保留 Rockchip 的内核内置支持，不改成需延后加载的模块。
# 保留现有 ttyd 的 libwebsockets-full 依赖，不引入额外 SIP 后端。
# CONFIG_PACKAGE_qmodem-sipd is not set
# LuCI 网页终端和官方 Aurora 主题
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-theme-aurora=y
# 文件管理、Aurora 设置与 Wi-Fi 热点自动连接。
CONFIG_PACKAGE_luci-app-filemanager=y
CONFIG_PACKAGE_luci-i18n-filemanager-zh-cn=y
CONFIG_PACKAGE_luci-app-aurora-config=y
CONFIG_PACKAGE_luci-i18n-aurora-config-zh-cn=y
CONFIG_PACKAGE_luci-app-travelmate=y
CONFIG_PACKAGE_luci-i18n-travelmate-zh-cn=y
CONFIG_PACKAGE_travelmate=y
# SQM/CAKE 使用官方软件包及默认配置，按需手动设置队列。
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-ifb=y
CONFIG_PACKAGE_tc-full=y
CONFIG_PACKAGE_bash=y
# 官方 iStore 和旧版 Lua LuCI 兼容依赖
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-compat=y
# iStore → luci-lib-taskd → taskd 依赖链
# 防止 make defconfig 静默取消依赖。
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_luci-lib-xterm=y
CONFIG_PACKAGE_taskd=y
CONFIG_PACKAGE_script-utils=y
CONFIG_PACKAGE_coreutils-stty=y
CONFIG_PACKAGE_mount-utils=y
# iStore 的 Makefile 明确依赖 tar。
# 历史问题 #38347186158：缺少 GNU tar 导致 iStore 被取消。
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_xz-utils=y
# GNU tar 默认启用 TAR_XZ，需对应 xz-utils。
# Docker 引擎、Compose 及 Dockerman 管理界面
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker-compose=y
# 多接口 Bandix Plus 流量统计，首次默认关闭。
CONFIG_PACKAGE_luci-app-bandix-plus=y
CONFIG_PACKAGE_bandix-plus=y
# DiskMan 使用官方源，保留 lsblk，关闭可选 Btrfs 工具链。
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-diskman_INCLUDE_lsblk=y
# CONFIG_PACKAGE_luci-app-diskman_INCLUDE_btrfs_progs is not set
# USB、PCIe、模组和存储诊断工具
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump=y
# 定时重启和 UPnP 内置，但不在这里设置为自动启用。
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-upnp=y
# 官方简体中文插件翻译
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
# 瑞昱 RTL8922AE、8852BE、8852CE（rtw89）
CONFIG_PACKAGE_kmod-rtw89-8922ae=y
CONFIG_PACKAGE_kmod-rtw89-8852be=y
CONFIG_PACKAGE_kmod-rtw89-8852ce=y
# 联发科 MT7925、MT7921/7922、MT7916
CONFIG_PACKAGE_kmod-mt7925e=y
CONFIG_PACKAGE_kmod-mt7921e=y
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7925-firmware=y
CONFIG_PACKAGE_kmod-mt7916-firmware=y
# 高通 QCNCM865（WCN7850）、QCA9880/9882（QCA988X）
CONFIG_PACKAGE_kmod-ath12k=y
CONFIG_PACKAGE_ath12k-firmware-wcn7850=y
CONFIG_PACKAGE_kmod-ath10k=y
CONFIG_PACKAGE_ath10k-firmware-qca988x=y
# 板载 QCA1023 / QCA9377 系列使用 SDIO，不使用 PCIe。
# 保留参考固件对应的 SDIO 固件与校准文件。
# 编译时向 kmod-ath10k 加入 ath10k_sdio.ko。
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_ath10k-firmware-qca9377-sdio=y
CONFIG_PACKAGE_ath10k-board-qca9377-sdio=y
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_luci-i18n-mwan3-zh-cn=y
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_cpufreq=y
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-i18n-cpufreq-zh-cn=y
CONFIG_PACKAGE_luci-app-photonicat-power=y
# 光影猫电池页面、顶部电量与 PMU 后台都在同一个包；停用旧版独立包和 Go FUSE 服务。
# CONFIG_PACKAGE_pcat-mgr is not set
# CONFIG_DEFAULT_pcat-mgr is not set
# CONFIG_PACKAGE_pcat-manager-v1 is not set
# CONFIG_PACKAGE_luci-mod-battstatus is not set
# CONFIG_PACKAGE_luci-i18n-battstatus-zh-cn is not set
CONFIG_PACKAGE_kmod-ath11k-pci=y
CONFIG_PACKAGE_ath11k-firmware-wcn6855=y
# QModem USB 模组：AT 串口和 QMI、MBIM、ECM、NCM、RNDIS 数据接口
# 官方 QModem 会带入部分依赖；这里明确选中以防将来依赖变化导致驱动缺失。
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=y
# 沿用西瓜皮的厂家 QMI 组合，避免通用 QMI 同时参与绑定。
# uqmi 强依赖通用 QMI 驱动，需同步关闭，QModem 使用上方 Tom 后端。
# CONFIG_PACKAGE_kmod-usb-net-qmi-wwan is not set
# CONFIG_PACKAGE_kmod-usb-net-qmi-wwan-fibocom is not set
# CONFIG_PACKAGE_kmod-usb-net-qmi-wwan-quectel is not set
# CONFIG_PACKAGE_uqmi is not set
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y

# ===== 明确禁用或有冲突的插件 =====
# 不内置历史统计及其专用采集组件。
# CONFIG_PACKAGE_luci-app-statistics is not set
# CONFIG_PACKAGE_luci-i18n-statistics-zh-cn is not set
# CONFIG_PACKAGE_collectd is not set
# CONFIG_PACKAGE_collectd-mod-ping is not set
# CONFIG_PACKAGE_collectd-mod-thermal is not set
# CONFIG_PACKAGE_luci-app-modemband is not set
# CONFIG_PACKAGE_luci-i18n-modemband-zh-cn is not set
# CONFIG_PACKAGE_modemband is not set
# CONFIG_PACKAGE_luci-app-sms-tool-js is not set
# CONFIG_PACKAGE_luci-i18n-sms-tool-js-zh-cn is not set
# CONFIG_PACKAGE_sms-tool is not set
# CONFIG_PACKAGE_luci-app-qmodem is not set
# CONFIG_PACKAGE_luci-app-qmodem-sms is not set
# CONFIG_PACKAGE_luci-app-qmodem-mwan is not set
# CONFIG_PACKAGE_luci-app-clash is not set
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-i18n-passwall-zh-cn is not set
# CONFIG_PACKAGE_luci-app-smartdns is not set
# CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn is not set
# CONFIG_PACKAGE_smartdns is not set
# CONFIG_PACKAGE_luci-app-zerotier is not set
# CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn is not set
# CONFIG_PACKAGE_zerotier is not set
# CONFIG_PACKAGE_kmod-ath10k-sdio is not set

# 参考配置遗留的串口拨号工具；QModem 使用自己的拨号和 AT 后端。
# 保留 wwan；模组驱动和拨号工具统一使用上方 QModem 选项。
# CONFIG_PACKAGE_comgt is not set
# CONFIG_PACKAGE_chat is not set
# 旧 Go pcat-mgr 使用 FUSE；当前 PMU-only 后台直接通过 Socket 提供状态。
# ext4、NTFS3、exFAT 等现有磁盘驱动不依赖 FUSE。
# CONFIG_PACKAGE_kmod-fuse is not set
# CONFIG_PACKAGE_libfuse is not set
# CONFIG_PACKAGE_fuse-utils is not set

# ===== 固件镜像：仅输出 squashfs（保留 ext4 文件系统驱动）=====
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_PACKAGE_kmod-fs-ext4=y

# ===== 全局编译选项 =====
CONFIG_DRIVER_11AC_SUPPORT=y
CONFIG_DRIVER_11AX_SUPPORT=y
CONFIG_DRIVER_11BE_SUPPORT=y
# CONFIG_RUBY_ENABLE_YJIT is not set
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_CCACHE_DIR=""

