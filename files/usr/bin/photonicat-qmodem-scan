#!/bin/sh
# 只在开机后的有限时间内补充官方 USB 扫描，不访问 AT 串口或改写模组配置。
SYSFS="${PHOTONICAT_QMODEM_SYSFS:-/sys}"
DEVFS="${PHOTONICAT_QMODEM_DEVFS:-/dev}"
RUNDIR="${PHOTONICAT_QMODEM_RUNDIR:-/var/run}"
SCANC="${PHOTONICAT_QMODEM_SCANC:-/usr/bin/modem_scanc}"
INIT="${PHOTONICAT_QMODEM_INIT:-/etc/init.d/qmodem_init}"
INTERVAL="${PHOTONICAT_QMODEM_INTERVAL:-5}"
ROUNDS="${PHOTONICAT_QMODEM_ROUNDS:-36}"
RECOVERY_ROUND="${PHOTONICAT_QMODEM_RECOVERY_ROUND:-18}"
snapshot=

note() { logger -t photonicat-qmodem-scan "$*"; }

# 固件不要求安装 timeout；只约束本脚本创建的短命令进程。
bounded() {
    local seconds="$1" child timer rc
    shift
    "$@" &
    child=$!
    (
        exec 9>&-
        sleeper=
        trap '[ -z "$sleeper" ] || { kill "$sleeper" 2>/dev/null || :; wait "$sleeper" 2>/dev/null || :; }' EXIT
        trap 'exit 0' INT TERM
        sleep "$seconds" &
        sleeper=$!
        wait "$sleeper" || exit 0
        sleeper=
        kill -TERM "$child" 2>/dev/null || exit 0
        sleep 1
        kill -KILL "$child" 2>/dev/null || :
    ) >/dev/null 2>&1 &
    timer=$!
    wait "$child"
    rc=$?
    kill "$timer" 2>/dev/null || :
    wait "$timer" 2>/dev/null || :
    return "$rc"
}

field() {
    local value
    value=$(printf '%s\n' "$snapshot" | awk -F= -v key="qmodem.$1.$2" \
        '$1 == key { print substr($0, length($1) + 2); exit }')
    value=${value#\'}
    value=${value%\'}
    printf '%s\n' "$value"
}

sections() {
    printf '%s\n' "$snapshot" | awk -F= \
        '$2 == "modem-device" { print substr($1, 8) }'
}

# 官方扫描是异步任务；忙碌时继续等待，不能用重复 add 打断尚未完成的识别。
scanner_idle() {
    local status
    status=$(bounded 5 "$SCANC" status 2>/dev/null) || return 1
    printf '%s\n' "$status" | jq -e '.queue == 0 and .active == 0' >/dev/null 2>&1
}

usb_parent() {
    local path="$1"
    while [ -n "$path" ] && [ "$path" != / ]; do
        if [ -f "$path/idVendor" ] && [ -f "$path/idProduct" ]; then
            printf '%s\n' "$path"
            return 0
        fi
        path=${path%/*}
    done
    return 1
}

has_tty() {
    local slot_path="$1" tty path
    for tty in "$SYSFS"/class/tty/ttyUSB* "$SYSFS"/class/tty/ttyACM*; do
        [ -c "$DEVFS/${tty##*/}" ] || continue
        path=$(readlink -f "$tty/device") || continue
        case "$path" in "$slot_path"/*) return 0 ;; esac
    done
    return 1
}

# 固定设备遵从用户设置；动态设备必须具有实际存在且属于同一 USB 槽位的 AT 口。
configured() {
    local slot_path="$1" net="$2" section path at tty_path
    for section in $(sections); do
        [ "$(field "$section" data_interface)" = usb ] || continue
        path=$(field "$section" path)
        path=$(readlink -f "$path") || continue
        [ "$path" = "$slot_path" ] || continue
        [ "$(field "$section" fixed_device)" = 1 ] && return 0
        [ "$(field "$section" state)" = enabled ] || continue
        [ -n "$(field "$section" name)" ] || continue
        case " $(field "$section" network) " in *" $net "*) ;; *) continue ;; esac
        at=$(field "$section" at_port)
        [ -c "$DEVFS/${at##*/}" ] || continue
        tty_path=$(readlink -f "$SYSFS/class/tty/${at##*/}/device") || continue
        case "$tty_path" in "$slot_path"/*) return 0 ;; esac
    done
    return 1
}

# 任意已识别、网卡仍在的模组都阻止自动重启扫描服务。
has_active_modem() {
    local section net
    for section in $(sections); do
        [ "$(field "$section" state)" = enabled ] || continue
        for net in $(field "$section" network); do
            [ -e "$SYSFS/class/net/$net" ] && return 0
        done
    done
    return 1
}

main() {
    local round pending_rounds=0 recovered=0 seen pending ready
    local net_path net device driver slot_path slot result
    command -v uci >/dev/null 2>&1 || return 0
    command -v flock >/dev/null 2>&1 || return 0
    command -v jq >/dev/null 2>&1 || return 0
    [ -x "$SCANC" ] && [ -x "$INIT" ] || return 0
    mkdir -p "$RUNDIR" || return 1
    exec 9>"$RUNDIR/photonicat-qmodem-scan.lock"
    flock -n 9 || return 0

    round=0
    while [ "$round" -lt "$ROUNDS" ]; do
        round=$((round + 1))
        if ! snapshot=$(bounded 5 uci -q show qmodem); then
            sleep "$INTERVAL"
            continue
        fi
        [ "$(field main enable_usb_scan)" = 1 ] || return 0
        [ "$(field main block_auto_probe)" != 1 ] || return 0
        pending=0
        ready=0
        seen=' '
        for net_path in "$SYSFS"/class/net/*; do
            [ -e "$net_path/device" ] || continue
            device=$(readlink -f "$net_path/device") || continue
            driver=$(readlink -f "$net_path/device/driver") || continue
            case "${driver##*/}" in
                qmi_wwan*|cdc_mbim|*cdc_ncm*|cdc_ether|rndis_host) ;;
                *) continue ;;
            esac
            slot_path=$(usb_parent "$device") || continue
            has_tty "$slot_path" || continue
            slot=${slot_path##*/}
            case "$seen" in *" $slot "*) continue ;; esac
            seen="$seen$slot "
            ready=$((ready + 1))
            net=${net_path##*/}
            configured "$slot_path" "$net" && continue
            pending=$((pending + 1))
            if [ $((pending_rounds % 3)) -eq 0 ] && scanner_idle; then
                result=$(bounded 5 "$SCANC" add "$slot" usb 2>&1)
                note "USB $slot ($net) 网卡和串口已就绪，补充扫描：$result"
            fi
        done
        if [ "$ready" -gt 0 ] && [ "$pending" -eq 0 ]; then
            note 'USB 模组已完成识别，结束开机检查'
            return 0
        fi
        if [ "$pending" -gt 0 ]; then
            pending_rounds=$((pending_rounds + 1))
            if [ "$pending_rounds" -ge "$RECOVERY_ROUND" ] && \
                [ "$recovered" -eq 0 ] && ! has_active_modem; then
                # 异步扫描可能刚刚成功；恢复前重新读取，避免使用本轮旧快照。
                if snapshot=$(bounded 5 uci -q show qmodem) && \
                    [ "$(field main enable_usb_scan)" = 1 ] && \
                    [ "$(field main block_auto_probe)" != 1 ] && ! has_active_modem; then
                    recovered=1
                    note 'USB 模组就绪后持续未识别，执行本轮唯一一次扫描服务恢复'
                    bounded 20 "$INIT" restart >/dev/null 2>&1 || \
                        note '扫描服务恢复未在期限内完成'
                fi
            fi
        else
            pending_rounds=0
        fi
        sleep "$INTERVAL"
    done
    [ "$pending_rounds" -eq 0 ] || note '开机识别检查达到上限，请查看 modem_scand 日志'
    return 0
}

main "$@"
