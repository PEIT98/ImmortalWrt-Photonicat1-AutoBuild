# 光影猫一代；不再静态绑定 USB 5G 拨号，交给 QModem 管理。
config interface 'loopback'
	option device 'lo'
	option proto 'static'
	list ipaddr '127.0.0.1/8'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'eth1'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '172.16.0.1'
	option netmask '255.255.255.0'
	option ip6assign '60'

config interface 'wan'
	option device 'eth0'
	option proto 'dhcp'
	option metric '5'

config interface 'wan6'
	option device '@wan'
	option proto 'dhcpv6'

# Wi-Fi STA 中继绑定到 wwan
config interface 'wwan'
	option proto 'dhcp'
	option metric '10'
	option peerdns '1'

# QModem 根据模块/插槽动态创建逻辑接口，例如 6_1、6_2；mwan3 自动识别 modem_config。
