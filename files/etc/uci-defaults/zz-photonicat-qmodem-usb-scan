#!/bin/sh
# 首次启用 USB 扫描与开机就绪检查，后续保留后台手动调整的值。
# 只使用官方 QModem 参数，不设置固定 USB 槽位、网卡名或模组别名。
set -eu
get() { uci -q get "$1" 2>/dev/null || true; }

# QModem 配置尚未就绪时保留首启脚本，下一次启动再尝试。
[ "$(get qmodem.main)" = main ] || exit 1
if [ "$(get qmodem.main.photonicat_usb_scan_defaults)" != 1 ]; then
    uci set qmodem.main.enable_usb_scan=1
    uci set qmodem.main.enable_pcie_scan=0
    uci set qmodem.main.try_preset_pcie=0
    uci set qmodem.main.start_delay=15
    uci set qmodem.main.photonicat_usb_scan_defaults=1
fi

# 独立迁移标记：旧固件升级也会启用新检查，但不重置已保存的扫描选项。
if [ "$(get qmodem.main.photonicat_usb_scan_guard_defaults)" != 1 ]; then
    "${PHOTONICAT_QMODEM_GUARD_INIT:-/etc/init.d/photonicat-qmodem-scan}" enable
    uci set qmodem.main.photonicat_usb_scan_guard_defaults=1
fi
uci commit qmodem
exit 0
