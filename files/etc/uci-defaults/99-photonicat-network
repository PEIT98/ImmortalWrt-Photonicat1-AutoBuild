#!/bin/sh
# 首启工具配置及一次性撤销旧网络定制；扫描、串口和拨号由官方 QModem 管理。
set -e
# 系统 UCI 函数库会直接读取可选变量及参数，不能在 nounset 下调用。
# 此文件也可能被 uci-defaults source，须同时关闭继承的 nounset。
set +u
die() { echo "photonicat-network: $*" >&2; exit 1; }
# uci-defaults 会被放在条件命令中 source，不能只依赖 set -e。
uci() {
    local action="$1"
    if command uci "$@"; then return 0; fi
    [ "$action" != -q ] || action="$2"
    case "$action" in
        get) return 1 ;;
        delete|del_list) [ "$1" != -q ] || return 1 ;;
    esac
    die "UCI $action 失败，保留配置任务供下次启动重试"
}
get() { uci -q get "$1" 2>/dev/null || true; }

mark_complete() {
    local key="$1" package="${1%%.*}"
    uci set "$key=1"
    if ! command uci commit "$package"; then
        # 提交失败时撤销暂存标记，当前启动期间再次运行也能重试。
        command uci -q revert "$key" >/dev/null 2>&1 || true
        die "UCI commit 失败，保留配置任务供下次启动重试"
    fi
}
check_network_globals() {
    local type
    type=$(get network.globals)
    [ -z "$type" ] || [ "$type" = globals ] || die 'network.globals 配置类型冲突'
}
mark_network_complete() {
    [ -n "$(get network.globals)" ] || uci set network.globals=globals
    mark_complete "network.globals.$1"
}

configure_network_tools() (
    base=${PHOTONICAT_DEFAULTS_ROOT:-}
    [ "$(get network.globals.photonicat_tools_v1)" != 1 ] || exit 0
    check_network_globals
    if [ -f "$base/etc/config/travelmate" ] && [ -z "$(get travelmate.global.trm_iface)" ]; then
        type=$(get network.wwan)
        if [ -z "$type" ]; then
            uci set network.wwan=interface
            uci set network.wwan.proto=dhcp
            uci commit network
        elif [ "$type" != interface ]; then
            die 'network.wwan 已被其他类型配置占用，请手动配置 Travelmate'
        fi
        uci set travelmate.global.trm_iface=wwan
        uci set travelmate.global.trm_enabled=0
        uci commit travelmate
    fi

    # 仅关闭未修改的 SQM 默认示例，保留用户配置及已启用的 autorate。
    if [ -f "$base/rom/etc/config/sqm" ] && cmp -s "$base/etc/config/sqm" "$base/rom/etc/config/sqm"; then
        queues=$(uci -q show sqm) || die '无法读取 SQM 配置'
        for section in $(printf '%s\n' "$queues" | sed -n 's/^sqm\.\([^.=]*\)=queue$/\1/p'); do
            uci set "sqm.$section.enabled=0"
        done
        uci commit sqm
    fi
    if [ -x "$base/etc/init.d/cake-autorate" ] && [ "$(get cake-autorate.main.enabled)" != 1 ]; then
        "$base/etc/init.d/cake-autorate" disable || die '无法关闭 cake-autorate 默认启动'
    fi
    mark_network_complete photonicat_tools_v1
)

configure_wan_firewall() (
    [ "$(get network.globals.photonicat_wan_v1)" != 1 ] || exit 0
    check_network_globals
    . "${PHOTONICAT_DEFAULTS_ROOT:-}/lib/functions.sh" || die '无法载入 UCI 配置函数'
    found=0
    configure_wan() {
        [ "$(get "firewall.$1.name")" = wan ] || return 0
        for name in wwan; do
            case " $(get "firewall.$1.network") " in *" $name "*) ;; *) uci add_list "firewall.$1.network=$name" ;; esac
        done
        found=1
    }
    config_load firewall || die '无法读取防火墙配置'
    config_foreach configure_wan zone || die '无法配置 WAN 防火墙区域'
    [ "$found" -eq 1 ] || die '未发现 WAN 防火墙区域，保留任务供下次启动重试'
    uci commit firewall
    mark_network_complete photonicat_wan_v1
)

restore_network_defaults() (
    [ "$(get network.globals.photonicat_stock_network_v2)" != 1 ] || exit 0
    check_network_globals
    base=${PHOTONICAT_DEFAULTS_ROOT:-}
    . "$base/lib/functions.sh" || die '无法载入 UCI 配置函数'

    # 本次同时清理旧 APN、串口、PDP 和拨号选择；官方扫描会重新生成模组记录。
    # v2 独立于上一版保留 APN 的 v1 标记，已运行 v1 的设备也会执行一次。
    [ -s "$base/rom/etc/config/qmodem" ] || die '缺少官方 QModem 默认配置，保留任务供下次启动重试'
    umask 077
    mkdir -p "$base/root" || die '无法创建配置备份目录'
    backup=$(mktemp -d "$base/root/photonicat-network-backup.XXXXXX") || die '无法创建网络配置备份'
    for package in qmodem network firewall dhcp mwan3; do
        [ ! -f "$base/etc/config/$package" ] || cp -p "$base/etc/config/$package" "$backup/" || die '网络配置备份失败'
    done
    # 使用独立包名核对 ROM，避免旧 UCI 暂存配置影响检查。
    stock_package="stock_qmodem_$$"
    cp "$base/rom/etc/config/qmodem" "$backup/$stock_package" || die '无法读取官方默认配置'
    mkdir "$backup/delta" || die '无法准备默认配置读取目录'
    [ "$(command uci -c "$backup" -t "$backup/delta" -q get "$stock_package.main")" = main ] || die '官方 QModem 默认配置无效'
    # import 不使用 -m：完整替换并提交，旧记录和未提交的 APN/串口改动一并清理。
    uci import qmodem < "$base/rom/etc/config/qmodem"

    removed=' '
    remove_modem_interface() {
        local section="$1"
        [ -n "$(get "network.$section.modem_config")" ] || return 0
        # 保留管理网络和常规 WAN；仅删除 QM 创建的独立逻辑接口。
        case "$section" in lan|wan|wan6|wwan|loopback) return 0 ;; esac
        uci delete "network.$section"
        removed="$removed$section "
    }
    config_load network || die '无法读取网络配置'
    config_foreach remove_modem_interface interface || die '无法清理旧模组接口'
    if [ -f "$base/etc/config/dhcp" ]; then
        remove_modem_dhcp() {
            local interface
            interface=$(get "dhcp.$1.interface")
            [ -n "$interface" ] || return 0
            case "$removed" in *" $interface "*) uci delete "dhcp.$1" ;; esac
            return 0
        }
        config_load dhcp || die '无法读取 DHCP 配置'
        config_foreach remove_modem_dhcp dhcp || die '无法清理旧模组 IPv6 配置'
        uci commit dhcp
    fi
    config_load firewall || die '无法读取防火墙配置'
    remove_modem_zone_names() {
        for name in $removed; do uci -q del_list "firewall.$1.network=$name" || true; done
    }
    config_foreach remove_modem_zone_names zone || die '无法清理旧模组防火墙关联'
    uci commit firewall
    echo "photonicat-network: 旧网络配置已备份到 $backup，QModem 已完整恢复官方默认"

    # 撤销项目预设路由优先级；普通 DHCP 路由交回 netifd。
    [ "$(get network.wan.metric)" != 5 ] || uci delete network.wan.metric
    case "$(get network.wwan.metric)" in 10|20) uci delete network.wwan.metric ;; esac
    uci commit network
    if [ -x "$base/etc/init.d/mwan3" ]; then
        "$base/etc/init.d/mwan3" disable || die '无法关闭 mwan3 默认启动'
        "$base/etc/init.d/mwan3" stop || die '无法停止旧 mwan3 路由策略'
    fi

    # 升级时移除旧项目的后台补扫和接口同步入口，不增加常驻任务。
    for service in photonicat-qmodem-mwan3 photonicat-qmodem-scan; do
        if [ -x "$base/etc/init.d/$service" ]; then
            "$base/etc/init.d/$service" stop >/dev/null 2>&1 || die '无法停止旧网络服务'
            "$base/etc/init.d/$service" disable >/dev/null 2>&1 || die '无法关闭旧网络服务'
        fi
        for link in "$base"/etc/rc.d/[SK][0-9][0-9]"$service"; do [ ! -L "$link" ] || unlink "$link" || die '无法清理旧服务启动链接'; done
        for file in "$base/etc/init.d/$service" "$base/usr/bin/$service"; do [ ! -f "$file" ] || unlink "$file" || die '无法清理旧网络服务'; done
    done
    for file in etc/hotplug.d/iface/95-photonicat-qmodem-mwan3 usr/bin/photonicat-qmodem-mwan3-sync; do
        [ ! -f "$base/$file" ] || unlink "$base/$file" || die '无法清理旧接口同步入口'
    done
    mark_network_complete photonicat_stock_network_v2
)

main() {
    local result=0
    restore_network_defaults || result=1
    configure_network_tools || result=1
    configure_wan_firewall || result=1
    return "$result"
}
main "$@"
