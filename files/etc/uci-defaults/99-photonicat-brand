#!/bin/sh
# Aurora 的登录页、左侧名称和浏览器标题均使用系统主机名。
# 升级时只迁移原发行版默认名称，保留用户自定义主机名。
set -eu
hostname="$(uci -q get 'system.@system[0].hostname' || true)"
case "$hostname" in
	''|OpenWrt|ImmortalWrt)
		uci set 'system.@system[0].hostname=Photonicat-Wrt'
		uci commit system
		;;
esac

# 使用系统自带 passwd 生成密码哈希；保留配置升级时不覆盖已设置的 root 密码。
if awk -F: '$1 == "root" && $2 == "" { empty = 1 } END { exit !empty }' /etc/shadow; then
	printf '%s\n%s\n' 'photonicat' 'photonicat' | passwd root >/dev/null
fi
exit 0
