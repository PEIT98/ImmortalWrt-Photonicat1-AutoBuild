#!/bin/sh
# Aurora 的登录页、左侧名称和浏览器标题均使用系统主机名。
# 升级时只迁移原发行版默认名称，保留用户自定义主机名。
set -eu
hostname="$(uci -q get 'system.@system[0].hostname' || true)"
case "$hostname" in
	''|OpenWrt|ImmortalWrt|Photonicat-Wrt|photonicat-wrt)
		uci set 'system.@system[0].hostname=Pwrt'
		uci commit system
		;;
esac

# 仅为未设置密码的 root 写入默认值；保留配置升级时不覆盖已有密码。
root_hash="$(awk -F: '$1 == "root" { print $2; found=1; exit } END { if (!found) exit 1 }' /etc/shadow)"
case "$root_hash" in
	''|'!'|'!!'|'*')
		printf '%s\n%s\n' 'photonicat' 'photonicat' | passwd root >/dev/null
		# passwd 返回成功后再次核对，避免首次启动留下无密码 root。
		awk -F: '$1 == "root" && $2 != "" && $2 != "!" && $2 != "!!" && $2 != "*" { ok=1 } END { exit !ok }' /etc/shadow
		;;
esac
exit 0
