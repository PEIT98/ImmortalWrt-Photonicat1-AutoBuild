#!/bin/sh
# 文件管理和 Aurora 使用上游默认值；首次统计只写入内存，Travelmate 保持关闭。
set -eu
get() { uci -q get "$1" 2>/dev/null || true; }

if [ -f /etc/config/travelmate ] && [ -z "$(get travelmate.global.trm_iface)" ]; then
	type="$(get network.wwan)"
	if [ -z "$type" ]; then
		uci set network.wwan=interface
		uci set network.wwan.proto=dhcp
		uci set network.wwan.metric=20
		uci commit network
	elif [ "$type" != interface ]; then
		logger -t photonicat-tools 'network.wwan 已被其他类型配置占用，请手动配置 Travelmate。'
		exit 1
	fi
	uci set travelmate.global.trm_iface=wwan
	uci set travelmate.global.trm_enabled=0
	uci commit travelmate
fi

# 只调整未经用户修改的原始默认统计配置；升级保留已有统计设置。
if [ -f /rom/etc/config/luci_statistics ] && cmp -s /etc/config/luci_statistics /rom/etc/config/luci_statistics; then
	uci set luci_statistics.collectd.Interval=60
	uci set luci_statistics.collectd_rrdtool.DataDir=/tmp/rrd
	uci set luci_statistics.collectd_rrdtool.backup=0
	uci set luci_statistics.collectd_thermal.enable=1
	uci set luci_statistics.collectd_ping.enable=1
	uci set 'luci_statistics.collectd_ping.Hosts=223.5.5.5 119.29.29.29'
	uci set luci_statistics.collectd_ping.Interval=60
	uci -q delete luci_statistics.collectd_interface.Interfaces || true
	uci set luci_statistics.collectd_interface.IgnoreSelected=0
	uci commit luci_statistics
fi

# 首次不启用 SQM 默认示例；保留用户此前修改过的 SQM 配置。
if [ -f /rom/etc/config/sqm ] && cmp -s /etc/config/sqm /rom/etc/config/sqm; then
	for section in $(uci -q show sqm | sed -n 's/^sqm\.\([^.=]*\)=queue$/\1/p'); do
		uci set "sqm.$section.enabled=0"
	done
	uci commit sqm
fi

# 装入固件不等于开启限速；保留用户此前明确启用的配置。
if [ "$(get cake-autorate.main.enabled)" != 1 ]; then
	/etc/init.d/cake-autorate disable
fi
exit 0
